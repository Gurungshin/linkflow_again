@model MyFirstMvcApp.Models.FAQ

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main>
    <div class="header-row">
        <div class="title-area">
            <h1> Add FaQ </h1>
            <div class="context-line">
                <span> Dashboard &mdash; <strong>Add FaQ</strong></span>
            </div>
        </div>
        <div class="header-meta">
            <span class="active-session-badge">● Active Session</span>
        </div>
    </div>

    <form method="post" class="resource-form-container">


        @if (TempData["Message"] != null)
        {
            <label id="mess">@TempData["Message"]</label>
        }

        <div class="form-group full-width">
            <label for="resourceTitle"> Add Question </label>
            <input type="text" name="Question" value="@Model?.Question" placeholder="Question ......" required />
        </div>

        <div class="form-group full-width">
            <label for="editor"> Add Answer </label>
            <textarea id="editor" name="Answer" placeholder="Answer.......">@Model?.Answer</textarea>
        </div>

        <div class="form-actions">
            @if (Model != null && Model.ID > 0)
            {
                <button type="submit" class="btn-submit">
                    Update FAQ
                </button>
            }
            else
            {
                <button type="submit" class="btn-submit">
                    Save FAQ
                </button>
            }
        </div>

    </form>


</main>

   <script>
    ClassicEditor
    .create(document.querySelector('#editor'), {
      toolbar: [ 'heading', '|', 'bold', 'italic', 'link', 'bulletedList', 'numberedList', 'blockQuote', 'undo', 'redo' ]
    })
    .catch(error => {
      console.error(error);
    });
  </script>