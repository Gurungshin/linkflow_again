@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main>
    <div class="header-row">
        <div class="title-area">
            <h1> Job Detail </h1>
            <div class="context-line">
                <span>Dashboard &mdash; <strong> Job Detail </strong></span>
            </div>
        </div>
    </div>

    <div class="controls-bar">
        <div class="search-wrapper">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="tableSearch" class="search-input" placeholder="Search entries..." />
        </div>
     
    </div>

    <div class="table-container">
        <table id="resourcesTable">
            <thead>
                <tr>
                    <th style="width:5%">Id</th>
                    <th style="width:15%">Job Title</th>
                    <th style="width:15%">Role</th>
                    <th style="width:10%">Job Type</th>
                    <th style="width:30%">Details</th>
                    <th style="width:10%">Keywords</th>
                    <th style="width:10%">Timespan</th>
                    <th style="width:5%; text-align:right;">Action</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr class="table-row">
                    <td data-label="Id">1</td>
                    <td data-label="Job Title">   <span class="td-name">Software Engineer</span> </td>
                    <td data-label="Role">Full Stack Developer</td>
                    <td data-label="Job Type">Full Time</td>
                    <td data-label="Details"> Develop and maintain ASP.NET applications, APIs, and SQL Server databases. </td>
                    <td data-label="Keywords"> ASP.NET, C#, SQL </td>
                    <td data-label="Timespan"> 2 days ago </td>
                    <td data-label="Action" style="text-align:right;">
                        <a href="/Admin/DeleteFAQ/"
                               class="btn-delete"
                               onclick="return confirm('Are you sure you want to delete this FAQ?');">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6l-1 14H6L5 6"></path>
                                    <path d="M10 11v6"></path>
                                    <path d="M14 11v6"></path>
                                    <path d="M9 6V4h6v2"></path>
                                </svg>
                            </a> </td>
                </tr>
              
            </tbody>
        </table>

        <div id="noResults" class="no-results">No resources match your search.</div>

        <div class="pagination-footer">
            <span id="paginationInfo"></span>
            <div class="pagination-buttons" id="paginationBtns"></div>
        </div>
    </div>
</main>
