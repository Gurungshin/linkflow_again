

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main>
    <div class="header-row">
        <div class="title-area">
            <h1>Blog Detailed</h1>
            <div class="context-line">
                <span>Dashboard &mdash; <strong>Blog Detailed</strong></span>
            </div>
        </div>
    </div>

    <div class="controls-bar">
        <div class="search-wrapper">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="tableSearch" class="search-input" placeholder="Search entries..." />
        </div>
    </div>

    <div class="table-container">
        <table id="resourcesTable">
            <thead>
                <tr>
                    <th style="width: 6%">Id</th>
                    <th style="width: 12%">Heading</th>
                    <th style="width: 7%">Image</th>
                    <th style="width: 7%">Url</th>
                    <th style="width: 18%">Small detailed</th>
                    <th style="width: 18%">Blog detailed</th>
                    <th style="width: 18%">Author detailed</th>
                    <th style="width: 12%; text-align: right">Action</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr class="table-row">
                    <td data-label="Id"> <a href="#">1 </a></td>
                    <td data-label="Heading">Standard corporate MSA template for inbound.</td>
                    <td data-label="Image" ><img src="" width="100" height="100"/></td>
                    <td data-label="Url" > Blog 1</td>
                    <td data-label="Small detailed">Standard corporate MSA template for inbound workflow automation</td>
                    <td data-label="Blog detailed">Standard corporate MSA template for inbound workflow automation</td>
                    <td data-label="Author detailed">Standard corporate MSA template for inbound workflow automation</td>
                    <td data-label="Action" style="text-align:right;">  <a href="#"
                               class="btn-delete"
                               onclick="return confirm('Are you sure you want to delete this Blogdetailed?');">
                                <svg width="16" height="16" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6l-1 14H6L5 6"></path>
                                    <path d="M10 11v6"></path>
                                    <path d="M14 11v6"></path>
                                    <path d="M9 6V4h6v2"></path>
                                </svg>
                            </a> </td>
                </tr>
               
                
            </tbody>
        </table>

        <div id="noResults" class="no-results">No resources match your search.</div>

        <div class="pagination-footer">
            <span id="paginationInfo"></span>
            <div class="pagination-buttons" id="paginationBtns"></div>
        </div>
    </div>
</main>
