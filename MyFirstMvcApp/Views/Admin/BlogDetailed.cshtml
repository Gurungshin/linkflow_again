

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .table {
        min-width: 1600px; /* Adjust based on your columns */
    }
</style>

<main>
    <div class="header-row">
        <div class="title-area">
            <h1>Blog Detailed</h1>
            <div class="context-line">
                <span>Dashboard &mdash; <strong>Blog Detailed</strong></span>
            </div>
        </div>
    </div>

    <div class="controls-bar">
        <div class="search-wrapper">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="tableSearch" class="search-input" placeholder="Search entries..." />
        </div>
    </div>

    <div class="table-container table-responsive">
        <table id="resourcesTable" class="table">
            <thead>
                <tr>
                    <th style="width: 5%">Id</th>
                    <th style="width: 15%">Heading</th>
                    <th style="width: 7%">Image</th>
                    <th style="width: 7%">Url</th>
                    <th style="width: 18%">Small detailed</th>
                    <th style="width: 18%">Blog detailed</th>
                    <th style="width: 18%">Author detailed</th>
                    <th style="width: 12%; text-align: right">Action</th>
                </tr>
            </thead>
            <tbody id="tableBody">

                @foreach (var item in Model)
                {
                    <tr class="table-row">
                        <td data-label="Id">
                            <a href="/Admin/AddBlogDetailed?Id=@item.ID">@item.ID</a>
                        </td>

                        <td data-label="Heading">
                            @item.BlogHeading
                        </td>

                        <td data-label="Image">
                            <img src="@item.ImagePath" width="100" height="100" />
                        </td>

                        <td data-label="Url">
                            @item.URL
                        </td>

                        <td data-label="Small detailed">
                            @item.Keyword
                        </td>

                        <td data-label="Blog detailed">
                        @{
                          var paragraph = System.Text.RegularExpressions.Regex.Replace(item.Paragraph ?? "", "<.*?>", "");
                        }
               @(paragraph.Length > 50 ? paragraph.Substring(0, 50) + "..." : paragraph)
              </td>

                <td data-label="Author detailed">
                  @{
                    var author = System.Text.RegularExpressions.Regex.Replace(item.Author ?? "", "<.*?>", "");
                   }
                   @(author.Length > 50 ? author.Substring(0, 50) + "..." : author)
              </td>

                <td data-label="Action" style="text-align:right;">
                           <a asp-action="DeleteBlogDetailed"
                            asp-route-id="@item.ID"
                             class="btn-delete"
                             onclick="return confirm('Are you sure you want to delete this Blog Detail?');">

                               <svg width="16" height="16" viewBox="0 0 24 24"
                               fill="none" stroke="currentColor" stroke-width="2">
                              <polyline points="3 6 5 6 21 6"></polyline>
                              <path d="M19 6l-1 14H6L5 6"></path>
                             <path d="M10 11v6"></path>
                             <path d="M14 11v6"></path>
                            <path d="M9 6V4h6v2"></path>
                         </svg>
                      </a>
                </td>
    </tr>
}
               
                
            </tbody>
        </table>

        <div id="noResults" class="no-results">No resources match your search.</div>

        <div class="pagination-footer">
            <span id="paginationInfo"></span>
            <div class="pagination-buttons" id="paginationBtns"></div>
        </div>
    </div>
</main>
