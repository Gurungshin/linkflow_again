@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main>
    <div class="header-row">
        <div class="title-area">
            <h1>Resources</h1>
            <p>Dynamic monitoring pipeline storage entries</p>
            <div class="context-line">
                <span>Library &mdash; <strong>Shared</strong></span>
            </div>
        </div>
        <div class="header-meta">
            <span class="active-session-badge">● Active Session</span>
        </div>
    </div>

    <div class="filter-tabs">
        <a href="#" class="tab-link active">All Files</a>
    </div>

    <div class="controls-bar">
        <div class="search-wrapper">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="tableSearch" class="search-input" placeholder="Search entries..." />
        </div>
        <button class="btn-action">+ Upload File</button>
    </div>

    <div class="table-container">
        <table id="resourcesTable">
            <thead>
                <tr>
                    <th style="width:10%"> Id </th>
                    <th style="width:30%"> Question </th>
                    <th style="width:40%"> Answer </th>
                    <th style="width:10%">Date & Time</th>
                    <th style="width:10%">Action</th>
                </tr>
            </thead>
            <tbody id="tableBody">

                @foreach (var item in Model)
                {
                    <tr class="table-row">
                        <td data-label="Id">
                            <span class="td-name">
                                <a href="/Admin/AddFaQ?ID=@item.ID">@item.ID</a>
                            </span>
                        </td>
                        <td data-label="Question"><span class="td-name"> @item.Question </span> </td>
                        <td data-label="Answer"> @item.Answer</td>
                        <td data-label="Date & Time"> @item.TimeSpan.ToString("dd-MM-yyyy")</td>
                        <td data-label="Action">
                            <a href="/Admin/DeleteFAQ/@item.ID"
                               class="btn-delete"
                               onclick="return confirm('Are you sure you want to delete this FAQ?');">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6l-1 14H6L5 6"></path>
                                    <path d="M10 11v6"></path>
                                    <path d="M14 11v6"></path>
                                    <path d="M9 6V4h6v2"></path>
                                </svg>
                            </a>
                        </td>
                    </tr>
                }

            </tbody>
        </table>

        <div id="noResults" class="no-results">No resources match your search.</div>

        <div class="pagination-footer">
            <span id="paginationInfo"></span>
            <div class="pagination-buttons" id="paginationBtns"></div>
        </div>
    </div>
</main>
