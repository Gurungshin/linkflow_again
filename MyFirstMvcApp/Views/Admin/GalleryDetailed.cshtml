@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main>
    <div class="header-row">
        <div class="title-area">
            <h1>Gallery Details</h1>
            <div class="context-line">
                <span>Dashboard &mdash; <strong>Gallery Detailed</strong></span>
            </div>
        </div>

    </div>

    <div class="filter-tabs">
        <a href="#" class="tab-link active">All Files</a>
    </div>

    <div class="controls-bar">
        <div class="search-wrapper">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="tableSearch" class="search-input" placeholder="Search entries..." />
        </div>
    </div>

    <div class="table-container">
        <table id="resourcesTable">
            <thead>
                <tr>
                    <th style="width:28%">Id </th>
                    <th style="width:44%">Image</th>
                    <th style="width:16%">Caption</th>
                    <th style="width:12%;text-align:right">Action</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @foreach (var item in Model)
                {
                    <tr>
                        <td data-label="ID">
                            <a href="/Admin/AddGallery?id=@item.Id">
                                @item.Id
                            </a>
                        </td>

                        <td data-label="Image">
                            <img src="@item.ImagePath" width="120" height="80" alt="Gallery Image" />
                        </td>

                        <td data-label="Caption">
                            @item.Caption
                        </td>

                        <td data-label="Action" style="text-align:right">
                            <a href="/Admin/DeleteGallery?id=@item.Id"
                               class="btn-delete"
                               onclick="return confirm('Are you sure you want to delete this gallery?');">
                                <svg width="16" height="16" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6l-1 14H6L5 6"></path>
                                    <path d="M10 11v6"></path>
                                    <path d="M14 11v6"></path>
                                    <path d="M9 6V4h6v2"></path>
                                </svg>
                            </a>
                        </td>
                    </tr>
                }

            </tbody>
        </table>

        <div class="pagination-footer">
            <span id="paginationInfo"></span>
            <div class="pagination-buttons" id="paginationBtns"></div>
        </div>
    </div>
</main>

