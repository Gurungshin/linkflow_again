@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@model List<MyFirstMvcApp.Models.Contact>

<main>
    <div class="header-row">
        <div class="title-area">
            <h1>Resources</h1>
            <p>Dynamic monitoring pipeline storage entries</p>
            <div class="context-line">
                <span>Library &mdash; <strong>Shared</strong></span>
            </div>
        </div>
        <div class="header-meta">
            <span class="active-session-badge">● Active Session</span>
        </div>
    </div>

    <div class="filter-tabs">
        <a href="#" class="tab-link active">All Files</a>
    </div>

    <div class="controls-bar">
        <div class="search-wrapper">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="tableSearch" class="search-input" placeholder="Search entries..." />
        </div>
        <button class="btn-action">+ Upload File</button>
    </div>

    <div class="table-container">
        <table id="resourcesTable">
            <thead>
                <tr>
                    <th style="width:20%">Name</th>
                    <th style="width:15%">Email Address</th>
                    <th style="width:15%">Subject</th>
                    <th style="width:30%">Message</th>
                    <th style="width:20%">Date & Time</th>
                </tr>
            </thead>
            <tbody id="tableBody">

                @foreach (var item in Model)
                {
                    <tr class="table-row">
                        <td data-label="Name"><span class="td-name"> @item.Name </span> </td>
                        <td data-label="Email Address"> @item.Email </td>
                        <td data-label="Subject" class="td-meta"> @item.Subject </td>
                        <td data-label="Message"> @item.Message </td>
                        <td data-label="Date & Time"> @item.TimeSpan </td>
                    </tr>
                }
           </tbody>
        </table>

        <div id="noResults" class="no-results">No resources match your search.</div>

        <div class="pagination-footer">
            <span id="paginationInfo"></span>
            <div class="pagination-buttons" id="paginationBtns"></div>
        </div>
    </div>
</main>
