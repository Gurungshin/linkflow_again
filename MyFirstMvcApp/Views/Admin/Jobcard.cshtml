@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main>
    <div class="header-row">
        <div class="title-area">
            <h1>Create Resource </h1>
            <div class="context-line">
                <span> Dashbaord &mdash; <strong> Job Card </strong></span>
            </div>
        </div>
    </div>

    <form method="post" class="resource-form-container">

        <div class="form-row">
            <div class="form-group">
                <label for="resourceCategory"> Job Title </label>
                <input type="text"  placeholder="e.g., Marketing" />
            </div>

                <div class="form-group">
                    <label for="resourceCategory"> Role </label>
                    <input type="text"  placeholder="e.g., Marketing Account" />
                </div>

                <div class="form-group">
                    <label for="resourceCategory"> Job Type </label>
                    <input type="text"  placeholder="e.g., parttime, remote job , full time " />
                </div>
        </div>

        <div class="form-group full-width">
            <label for="editor"> Details </label>
            <textarea id="editor" placeholder="Describe the structural logic mapping..."></textarea>
        </div>

            <div class="form-group full-width">
                <label for="editor">KeyWord</label>
                <input type="text" placeholder="e.g., Schema, Kit, Template" />
            </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">Save Entries</button>
        </div>

    </form>
</main>
