@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main>
    <div class="header-row">
        <div class="title-area">
            <h1>Add Service</h1>
            <div class="context-line">
                <span>Dashboard &mdash; <strong>Add Service</strong></span>
            </div>
        </div>

    </div>

    <form method="post" class="resource-form-container">

        <input type="hidden" name="ID" value="@Model?.ID" />

        @if (TempData["Message"] != null)
        {
            <label id="mess">@TempData["Message"]</label>
        }

        <div class="form-group full-width">
            <label>Heading (Title)</label>
            <input type="text"
                   name="Heading"
                   value="@Model?.Heading"
                   placeholder="e.g., Master Signal Ingestion Hub"
                   required />
        </div>

        <div class="form-group full-width">
            <label>Paragraph</label>
            <textarea id="editor"
                      name="Paragraph"
                      placeholder="Describe the structural logic mapping...">@Model?.Paragraph</textarea>
        </div>

        <div class="form-group full-width">
            <label>Service detailed</label>
            <textarea id="editor2"
                      name="ServiceDetails"
                      placeholder="Describe the secondary logic mapping...">@Model?.ServiceDetails</textarea>
        </div>

        <div class="form-actions">
        @if (Model != null && Model.ID > 0)
        {
            <button type="submit" class="btn-submit">
                    Update Service
            </button>
        }
        else
        {
            <button type="submit" class="btn-submit">
                Add Service
            </button>
        }

        </div>


    </form>
</main>

<script>
    ClassicEditor
        .create(document.querySelector('#editor2'))
        .catch(error => console.error(error));
</script>

