<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LinkFlow — Close the rift</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/admin_css/admin.css" /> 
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
  
</head>
<body>

    <div class="mobile-header">
        <a href="index.html" class="logo" style="margin-bottom:0;">LinkFlow<sup>TM</sup></a>
        <button class="menu-toggle" id="menuBtn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
    </div>

    <aside id="sidebar">
        <a href="index.html" class="logo">LinkFlow<sup>TM</sup></a>
        <nav>
            <div class="nav-label">Main</div>

            <a href="/Admin/index" class="nav-item active" style="justify-content:flex-start;gap:8px;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                Resources
            </a>

            <div class="nav-item" onclick="toggleDropdown('dd-workspace', this)">
                <span style="display:flex;align-items:center;gap:8px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        <path d="M9 9a3 3 0 1 1 6 0c0 2-3 3-3 3"></path>
                        <circle cx="12" cy="17" r="1"></circle>
                    </svg>
                   F A Q
                </span>
                <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
            </div>
            <div class="nav-dropdown" id="dd-workspace">
                <a href="/Admin/AddFaQ" class="nav-sub-item">Add FaQ</a>
                <a href="/Admin/FaQdetails" class="nav-sub-item"> View FaQ details </a>
            </div>


            <div class="nav-item" onclick="toggleDropdown('dd-workflows', this)">
                <span style="display:flex;align-items:center;gap:8px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                        <path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"></path>
                        <path d="M2 12h20"></path>
                    </svg>
                    Job card
                </span>
                <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
            </div>
            <div class="nav-dropdown" id="dd-workflows">
                <a href="/Admin/jobcard" class="nav-sub-item"> Add Job </a>
                <a href="/Admin/jobDetail" class="nav-sub-item"> Job details </a>
            </div>

           

            <div class="nav-item" onclick="toggleDropdown('dd-analytics', this)">
                <span style="display:flex;align-items:center;gap:8px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.1a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                    Service Detailed
                </span>
                <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
            </div>
            <div class="nav-dropdown" id="dd-analytics">
                <a href="/Admin/AddService" class="nav-sub-item"> Add Service detailed </a>
                <a href="/Admin/ServiceDetailed" class="nav-sub-item"> Serivice Detailed </a>
            </div>

            <div class="nav-item" onclick="toggleDropdown('dd-gallery', this)">
                <span style="display:flex;align-items:center;gap:8px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                        <circle cx="8.5" cy="8.5" r="1.5" />
                        <polyline points="21 15 16 10 5 21" />
                    </svg>
                    Gallery
                </span>
                <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
            </div>
            <div class="nav-dropdown" id="dd-gallery">
                <a href="/Admin/AddGallery" class="nav-sub-item"> Add Gallery </a>
                <a href="/Admin/GalleryDetailed" class="nav-sub-item"> Gallery Detailed </a>
            </div>


            <div class="nav-item" onclick="toggleDropdown('dd-blog', this)">
                <span style="display:flex;align-items:center;gap:8px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />

                        <rect x="8" y="6" width="8" height="5" rx="1" opacity="0.8" stroke-width="1.5" />
                        <line x1="8" y1="15" x2="16" y2="15" />
                        <line x1="8" y1="18" x2="13" y2="18" opacity="0.6" />
                    </svg>

                    Blog Card
                </span>
                <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
            </div>
            <div class="nav-dropdown" id="dd-blog">
                <a href="/Admin/BlogCard" class="nav-sub-item"> Add Blog Card </a>
                <a href="/Admin/BlogCarddetailed" class="nav-sub-item"> Blog Card Detailed </a>
            </div>

            <div class="nav-item" onclick="toggleDropdown('dd-blog-detailed', this)">
                <span style="display:flex;align-items:center;gap:8px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />

                        <rect x="6" y="6" width="12" height="6" rx="1" opacity="0.8" />
                        <circle cx="9" cy="8" r="0.75" />
                        <polyline points="18 11 15 9 11 12" stroke-width="1.5" />

                        <line x1="6" y1="15" x2="18" y2="15" />
                        <line x1="6" y1="18" x2="14" y2="18" opacity="0.6" />
                    </svg>

                    Blog Detailed
                </span>
                <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
            </div>
            <div class="nav-dropdown" id="dd-blog-detailed">
                <a href="/Admin/BlogCard" class="nav-sub-item"> Add Blog Detailed </a>
                <a href="/Admin/BlogCarddetailed" class="nav-sub-item"> Blog Detailed </a>
            </div>


        </nav>

        <div class="sidebar-footer">
            <strong>Jimmy Sullivan</strong> Project Manager
            <button class="logout-btn" onclick="alert('Logging out…')">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Log Out
            </button>
        </div>



    </aside>

            @RenderBody()

  <script src="~/admin_js/admin.js"></script>
  <script src="~/admin_js/formadmin.js"></script>

</body>
</html>