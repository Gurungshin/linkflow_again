<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LinkFlow — Close the rift</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/admin_css/admin.css" /> 
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
  
</head>
<body>

    <div class="mobile-header">
        <a href="index.html" class="logo" style="margin-bottom:0;">LinkFlow<sup>TM</sup></a>
        <button class="menu-toggle" id="menuBtn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
    </div>

    <aside id="sidebar">
        <a href="index.html" class="logo">LinkFlow<sup>TM</sup></a>
        <nav>
            <div class="nav-label">Main</div>

            <a href="/Admin/index" class="nav-item active" style="justify-content:flex-start;gap:8px;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                Resources
            </a>

            <div class="nav-item" onclick="toggleDropdown('dd-workspace', this)">
                <span style="display:flex;align-items:center;gap:8px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        <path d="M9 9a3 3 0 1 1 6 0c0 2-3 3-3 3"></path>
                        <circle cx="12" cy="17" r="1"></circle>
                    </svg>
                   F A Q
                </span>
                <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
            </div>
            <div class="nav-dropdown" id="dd-workspace">
                <a href="/Admin/AddFaQ" class="nav-sub-item">Add FaQ</a>
                <a href="/Admin/FaQdetails" class="nav-sub-item"> View FaQ details </a>
            </div>


            <div class="nav-item" onclick="toggleDropdown('dd-workflows', this)">
                <span style="display:flex;align-items:center;gap:8px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>
                    Workflows
                </span>
                <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
            </div>
            <div class="nav-dropdown" id="dd-workflows">
                <a href="#" class="nav-sub-item">Active Flows</a>
                <a href="#" class="nav-sub-item">Automations</a>
            </div>

           

            <div class="nav-item" onclick="toggleDropdown('dd-analytics', this)">
                <span style="display:flex;align-items:center;gap:8px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" />
                        <line x1="6" y1="20" x2="6" y2="14" /></svg>
                    Analytics
                </span>
                <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
            </div>
            <div class="nav-dropdown" id="dd-analytics">
                <a href="#" class="nav-sub-item">Reports</a>
                <a href="#" class="nav-sub-item">Audit Logs</a>
            </div>


        </nav>

        <div class="sidebar-footer">
            <strong>Jimmy Sullivan</strong> Project Manager
            <button class="logout-btn" onclick="alert('Logging out…')">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Log Out
            </button>
        </div>
    </aside>

            @RenderBody()

  <script src="~/admin_js/admin.js"></script>
  <script src="~/admin_js/formadmin.js"></script>

</body>
</html>