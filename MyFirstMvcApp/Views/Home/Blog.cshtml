@{
    ViewData["Title"] = "Blog";
}


<div class="hero-banner position-relative">
    <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1800&q=80" alt="LinkFlow core infrastructure mesh architecture" />
    <div class="hero-banner-overlay"></div>

    <div class="hero-banner-text w-100 position-absolute bottom-0 start-0">
        <div class="custom-container" style="padding-top: 48px; padding-bottom: 48px;">
            <div class="hero-eyebrow mb-2"><span></span> Blog </div>
            <h1 class="text-white m-0" style="font-size: calc(1.425rem + 2.1vw); font-weight: 300; line-height: 1.2;">Blog cards</h1>
        </div>
    </div>
</div>

<section id="values" class="py-5" style="background-color: #faf9f5; display: block !important;">
    <div class="custom-container">

        <div class="gsap-reveal mb-5" id="valuesHeader">
            <div class="section-eyebrow mb-3 d-flex align-items-center gap-2">
                <span class="text-uppercase fw-bold" style="font-size: 0.6875rem; color: #336443; letter-spacing: 0.12em;">Blog</span>
            </div>
            <h2 class="fw-normal text-dark mb-0" style="font-size: calc(1.375rem + 1.5vw); line-height: 1.2; letter-spacing: -0.03em;">The principles that shape everything </h2>
        </div>

        <div class="blog-grid-wrapper">

            <div class="lf-blog-card gsap-reveal">
                <div class="lf-img-container">
                    <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=800&q=80" alt="Ruthless reliability" />
                    <span class="lf-card-badge">01</span>
                </div>
                <div class="lf-card-body">
                    <h3>Ruthless reliability</h3>
                    <p class="flex-grow-1">
                        Workflows are mission-critical infrastructure. We hold ourselves to 99.99% uptime and treat every downtime minute as a personal failure. Reliability isn't a feature — it's the foundation.
                    </p>
                    <a href="/Home/BlogDetail" class="text-decoration-none fw-semibold d-inline-flex align-items-center gap-1" style="color: #336443; font-size: 0.875rem;">
                        Read More
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </a>
                </div>
            </div>

            <div class="lf-blog-card gsap-reveal">
                <div class="lf-img-container">
                    <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=800&q=80" alt="People over pipelines" />
                    <span class="lf-card-badge">02</span>
                </div>
                <div class="lf-card-body">
                    <h3>People over pipelines</h3>
                    <p class="flex-grow-1">
                        Technology should amplify human judgement, not replace it. We build tools that give people back the time to think, create, and make decisions — not tools that make decisions for them.
                    </p>
                    <a href="Blog-detailed.html" class="text-decoration-none fw-semibold d-inline-flex align-items-center gap-1" style="color: #336443; font-size: 0.875rem;">
                        Read More
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </a>
                </div>
            </div>

            <div class="lf-blog-card gsap-reveal">
                <div class="lf-img-container">
                    <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80" alt="Radical transparency" />
                    <span class="lf-card-badge">03</span>
                </div>
                <div class="lf-card-body">
                    <h3>Radical transparency</h3>
                    <p class="flex-grow-1">
                        Every workflow run is fully observable. Every pricing tier is honestly documented. We don't hide complexity behind abstraction — we make it legible so you stay in control.
                    </p>
                    <a href="Blog-detailed.html" class="text-decoration-none fw-semibold d-inline-flex align-items-center gap-1" style="color: #336443; font-size: 0.875rem;">
                        Read More
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </a>
                </div>
            </div>

            <div class="lf-blog-card gsap-reveal">
                <div class="lf-img-container">
                    <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=800&q=80" alt="Default to speed" />
                    <span class="lf-card-badge">04</span>
                </div>
                <div class="lf-card-body">
                    <h3>Default to speed</h3>
                    <p class="flex-grow-1">
                        Slow iteration is a form of disrespect to the people waiting for a solution. We ship fast, learn fast, and fix fast. Perfection is a direction, not a destination before launch.
                    </p>
                    <a href="Blog-detailed.html" class="text-decoration-none fw-semibold d-inline-flex align-items-center gap-1" style="color: #336443; font-size: 0.875rem;">
                        Read More
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </a>
                </div>
            </div>

            <div class="lf-blog-card gsap-reveal">
                <div class="lf-img-container">
                    <img src="https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=800&q=80" alt="Security is non-negotiable" />
                    <span class="lf-card-badge">05</span>
                </div>
                <div class="lf-card-body">
                    <h3>Security is non-negotiable</h3>
                    <p class="flex-grow-1">
                        We handle sensitive data for thousands of teams. SOC 2 Type II, end-to-end encryption, and zero-trust architecture aren't checkboxes — they're the baseline we hold ourselves to from day one.
                    </p>
                    <a href="Blog-detailed.html" class="text-decoration-none fw-semibold d-inline-flex align-items-center gap-1" style="color: #336443; font-size: 0.875rem;">
                        Read More
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </a>
                </div>
            </div>

            <div class="lf-blog-card gsap-reveal">
                <div class="lf-img-container">
                    <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=800&q=80" alt="Genuine curiosity" />
                    <span class="lf-card-badge">06</span>
                </div>
                <div class="lf-card-body">
                    <h3>Genuine curiosity</h3>
                    <p class="flex-grow-1">
                        The best automation ideas don't come from engineers alone — they come from listening obsessively to the people running operations at 2am. We stay close to the problem, always.
                    </p>
                    <a href="Blog-detailed.html" class="text-decoration-none fw-semibold d-inline-flex align-items-center gap-1" style="color: #336443; font-size: 0.875rem;">
                        Read More
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>