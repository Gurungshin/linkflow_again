@model List<MyFirstMvcApp.Models.Gallery>

@{
    Layout = "_Layout";

    ViewData["MetaTitle"] = "Gallery | LinkFlow";
    ViewData["MetaDescription"] = "Browse images showcasing LinkFlow projects, events, and company highlights";
    ViewData["Keywords"] = "LinkFlow gallery";
}

<div class="hero-banner position-relative">
    <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1800&q=80" alt="LinkFlow services — modern workspace" />
    <div class="hero-banner-overlay"></div>

    <div class="hero-banner-text w-100">
        <div class="container conx">
            <div class="hero-eyebrow"><span></span> What We Offer</div>
            <h1>Our <em>Gallery</em></h1>
        </div>
    </div>
</div>

<div class="gallery-section-wrapper">
    <div class="container conx">
        <div class="services-gallery-grid">

            @foreach (var item in Model)
            {
                <div class="cardxx">
                    <div class="cardxx-image">
                        <a href="@item.ImagePath"
                           data-fancybox="gallery"
                           data-caption="@item.Caption">

                            <img src="@item.ImagePath"
                                 alt="@item.Caption">
                        </a>
                    </div>
                </div>
            }

        </div>
    </div>
</div>