@model MyFirstMvcApp.Models.Blogdetails

@{
    ViewData["Title"] = "Blog details";
}

<style>
  
</style>

<div class="hero-banner position-relative">
    <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1800&q=80" alt="LinkFlow core infrastructure mesh architecture" />
    <div class="hero-banner-overlay"></div>

    <div class="hero-banner-text w-100 position-absolute bottom-0 start-0">
        <div class="custom-container" style="padding-top: 48px; padding-bottom: 48px;">
            <div class="hero-eyebrow mb-2"><span></span> Blog Details </div>
            <h1 class="text-white m-0" style="font-size: calc(1.425rem + 2.1vw); font-weight: 300; line-height: 1.2;">Blog Details</h1>
        </div>
    </div>
</div>

<main class="custom-container py-3" style="margin-top: 40px; margin-bottom: 40px;">

    <div class="article-header-block">
        <div class="d-flex align-items-center gap-3 blog-meta-inline mb-3" style="font-size: 0.875rem;">
            <span>@Model.TimeSpan.ToString("dd MMMM yyyy")</span>
            <span class="blog-meta-dot"></span>
            <span>@Model.Keyword</span>
            <span class="blog-meta-dot"></span>
            @{
                var plainText = System.Text.RegularExpressions.Regex.Replace(Model.Paragraph ?? "", "<.*?>", "");
                var words = plainText.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
                var readTime = Math.Max(1, (int)Math.Ceiling(words / 200.0));
            }

            <span>@readTime Min Read</span>
        </div>
    </div>

    <div class="article-hero-media">
        <img src="@Model.ImagePath" alt="LinkFlow data visual" />
    </div>

    <div class="article-split-layout" id="mainArticleRow">

        <article class="blog-main-content gsap-reveal" id="articleContent">
            <h1 class="mt-0" style="font-size: calc(1.375rem + 1.5vw); line-height: 1.2; font-weight: 400;">@Model.BlogHeading </h1>
              <div>
                @Html.Raw(Model.Paragraph)
              </div>
        </article>

        <aside class="sidebar-border-box">
            <div id="stickySidebarInner" style="width: 100%;">

                <div class="mb-4">
                    @Html.Raw(Model.Author)
                </div>

              @*   <div class="share-box-container">
                    <div class="author-title text-uppercase mb-3" style="font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.12em; color: #1f2a1d; margin-bottom: 12px;">Share</div>
                    <div class="d-flex gap-2">
                        <a href="#" class="share-circle" aria-label="Share on Facebook">FB</a>
                        <a href="#" class="share-circle" aria-label="Share on LinkedIn">LN</a>
                        <a href="#" class="share-circle" aria-label="Share on Twitter / X">TW</a>
                    </div>
                </div> *@

            </div>
        </aside>

    </div>

    <section class="related-section gsap-reveal" style="margin-top: 64px; margin-bottom: 32px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="related-title mb-0" style="font-size: 1.5rem; font-weight: 500;">Related News</h3>
            <a href="/Home/Blog" class="lf-btn-pill">See All</a>
        </div>

        <div class="related-news-grid">

            @foreach (var item in ViewBag.RelatedBlogs)
            {
                <div class="d-flex flex-column">

                    <div class="related-card-img mb-3">
                        <img src="@item.ImagePath" alt="@item.Heading" />
                    </div>

                    <h4 class="fw-medium text-dark mb-1"
                        style="font-size: 1rem; margin: 0 0 4px 0; line-height: 1.4;">
                        @item.Heading
                    </h4>

                    <span class="text-muted small mb-3"
                          style="margin-bottom: 12px; display: block;">
                        @item.TimeSpan.ToString("dd MMMM yyyy")
                    </span>

                    <a asp-controller="Home"
                       asp-action="BlogDetail"
                       asp-route-url="@item.URL"
                       class="text-decoration-none fw-semibold d-inline-flex align-items-center gap-1"
                       style="color: #336443; font-size: 0.8125rem;">

                        Read More

                        <svg width="14" height="14"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2.5"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>

                    </a>

                </div>
            }


        </div>
    </section>

</main>

