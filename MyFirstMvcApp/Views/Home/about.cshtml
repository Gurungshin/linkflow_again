@model List<FAQ>

@{
    Layout = "_Layout";

    ViewData["MetaTitle"] = "About LinkFlow | Workflow Automation & AI Solutions";
    ViewData["MetaDescription"] = "Learn about LinkFlow, our mission, and how we help businesses streamline operations with workflow automation, AI, integrations, and consulting services.";
