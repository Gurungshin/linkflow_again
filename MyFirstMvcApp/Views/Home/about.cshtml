<section class="about-heros">
    <div class="about-hero-grid"></div>
    <div class="about-hero-inner">
        <div class="about-hero-lefts gsap-reveal" id="heroLeft">
            <div class="eyebrow"><span></span> About LinkFlow</div>
            <h1>Built to end the<br><em>data rift,</em><br>for good.</h1>
            <p>We're a team of engineers, operators, and builders who got tired of watching smart people waste their days copy-pasting between tools. So we built the thing we always wished existed.</p>
        </div>
        <div class="about-hero-rights gsap-reveal" id="heroRight">
            <div class="hero-stats">
                <div class="num">4<span class="unit">k+</span></div>
                <div class="label">Teams running workflows today</div>
            </div>
            <div class="hero-stats">
                <div class="num">340<span class="unit">+</span></div>
                <div class="label">Native integrations available</div>
            </div>
            <div class="hero-stats">
                <div class="num">2.1<span class="unit">B</span></div>
                <div class="label">Events processed this month</div>
            </div>
            <div class="hero-stats">
                <div class="num">99<span class="unit">.9%</span></div>
                <div class="label">Uptime across all regions</div>
            </div>
        </div>
    </div>
</section>

