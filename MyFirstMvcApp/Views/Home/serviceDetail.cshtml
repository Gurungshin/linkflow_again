@model MyFirstMvcApp.Models.ServiceDetailed

@{
    ViewData["Title"] = "service-detailed";
}


<div class="hero-banner position-relative">
    <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1800&q=80" alt="LinkFlow services — modern workspace" />
    <div class="hero-banner-overlay"></div>

    <div class="hero-banner-text w-100">
        <div class="custom-container">
            <div class="hero-eyebrow"><span></span> Service Detailed </div>
            <h1>@Model.Heading</h1>
        </div>
    </div>
</div>

<div class="custom-container">
    <div class="services-grid">

        <div class="content-column-left">

            <div class="intro-block pb-5" id="servicesIntro">
                @Html.Raw(Model.Paragraph)
            </div>

            <div class="service-section" id="workflow">
                @Html.Raw(Model.ServiceDetails)
            </div>
        </div>



        <div id="stickyColumn">
            <div class="sticky-form-wrapper">
                <div class="contact-card">
                    <div class="card-eyebrow">Get in touch</div>
                    <h3>Talk to our team</h3>
                    <div class="form-divider" style="margin: 16px 0 24px 0;"></div>

                    <form asp-controller="Home"
                          asp-action="serviceDetail"
                          asp-route-url="@Model.URL"
                          method="post"
                          id="contactForm">
                        <div class="field mb-3">
                            <input type="text" name="Name" placeholder="Jane Smith" required style="width: 100%;" />
                        </div>
                        <div class="field mb-3">
                            <input type="email" name="Email" placeholder="jane@company.com" required style="width: 100%;" />
                        </div>
                        <div class="field mb-3">
                            <input type="text" name="CompanyName" placeholder="Acme Inc." style="width: 100%;" />
                        </div>
                        <div class="field mb-3">
                            <select name="service" style="width: 100%;">
                                <option value="" disabled selected>Select a service…</option>
                                <option value="Workflow-Automation">Workflow Automation</option>
                                <option value="FluxEngine-AI">FluxEngine-AI</option>
                            </select>
                        </div>
                        <div class="field mb-3">
                            <textarea name="Message" placeholder="Briefly describe what's slowing your team down…" style="width: 100%; min-height: 100px;"></textarea>
                        </div>
                        <button type="submit" class="submit-btn" style="width: 100%;">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>